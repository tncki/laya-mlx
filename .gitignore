.venv/
# The upstream checkout CI clones. No trailing slash: a symlink to an existing checkout
# (`.upstream -> ../laya`) is not matched by the directory-only pattern and would otherwise
# be committed as a local absolute path.
.upstream
.cache/
models/
*.safetensors
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.DS_Store
.env
*.log
artifacts/
